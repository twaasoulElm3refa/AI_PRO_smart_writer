APP_NAME=AI Tools
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

ALLOWED_ORIGINS=*
DATABASE_URL=mysql+pymysql://DB_USERNAME:DB_PASSWORD@127.0.0.1:3306/DB_DATABASE

DATABASE_URL=sqlite:///./ai_gateway.db
REQUEST_TIMEOUT_SECONDS=60

OPENROUTER_API_KEY= key_
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v3.2
OPENROUTER_TITLE_MODEL=

INTERNAL_API_KEY=api_key

CHAT_MAX_CONTEXT_TOKENS=3000 
CHAT_RESERVED_RESPONSE_TOKENS=600 