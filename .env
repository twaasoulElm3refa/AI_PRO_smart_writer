APP_NAME=AI Tools
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=9000

ALLOWED_ORIGINS=*
DATABASE_URL=db
input_cost = input_tokens / 1000000 * 0.100
output_cost = output_tokens / 1000000 * 0.500

OPENROUTER_API_KEY=PUT_YOUR_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_CHAT_MODEL               = qwen/qwen3.5-flash-02-23
OPENROUTER_SUMMARIZER_MODEL         = nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_HEADLINE_MODEL           = nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_PARAPHRASER_MODEL        = nvidia/nemotron-3-super-120b-a12b:free

OPENROUTER_HEADLINE_EXTRACTOR_MODEL = openai/gpt-oss-120b:free

HEADLINE_DEFAULT_COUNT=5
HEADLINE_MAX_CONTENT_CHARS=1000

HEADLINE_INPUT_COST_PER_1M=0.100
HEADLINE_OUTPUT_COST_PER_1M=0.500

REQUEST_TIMEOUT_SECONDS=180
DEFAULT_TEMPERATURE=0.45
DEFAULT_MAX_TOKENS=2500
DEFAULT_HISTORY_LIMIT=4
MAX_HISTORY_MESSAGES=6

WEB_SEARCH_DEFAULT_MAX_RESULTS=3
WEB_SEARCH_DEFAULT_MAX_TOTAL_RESULTS=5
WEB_SEARCH_HARD_MAX_RESULTS=5
WEB_SEARCH_HARD_MAX_TOTAL_RESULTS=10



CHAT_MAX_CONTEXT_TOKENS=3000 
CHAT_RESERVED_RESPONSE_TOKENS=600 